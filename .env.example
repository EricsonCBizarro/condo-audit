# Copy to .env (`make env` does it and fills the secrets with random values).
# Never commit .env.

# --- API -------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
# Generated by `make env` (base64:<32 random bytes>).
APP_KEY=

# --- PostgreSQL ------------------------------------------------------------
DB_DATABASE=condo_audit
DB_USERNAME=condo_audit
DB_PASSWORD=

# --- S3-compatible object storage -------------------------------------------
S3_BUCKET=documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Demo login (fictional data only) ---------------------------------------
DEMO_USER_EMAIL=auditor@example.com
DEMO_USER_PASSWORD=

# --- Host ports for local tools (psql, redis-cli, S3 clients) ----------------
DB_FORWARD_PORT=55432
REDIS_FORWARD_PORT=56379
S3_FORWARD_PORT=58333

LOG_LEVEL=INFO
